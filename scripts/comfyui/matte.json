{
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "__IMAGE__", "upload": "image" }
  },
  "2": {
    "class_type": "BiRefNetRMBG",
    "inputs": {
      "image": ["1", 0],
      "model": "__MODEL__",
      "sensitivity": 1.0,
      "mask_blur": 0,
      "mask_offset": 0,
      "invert_output": false,
      "refine_foreground": true,
      "background": "Alpha",
      "background_color": "#222222"
    }
  },
  "3": {
    "class_type": "SaveImage",
    "inputs": { "images": ["2", 0], "filename_prefix": "bevytris/matte" }
  }
}
